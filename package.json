{
  "name": "agentdeck",
  "version": "0.2.5.3",
  "type": "module",
  "private": true,
  "description": "AgentDeck — self-hosted, gstack-native orchestrator for parallel Claude Code agents. Air-traffic-control board for your VPS.",
  "license": "MIT",
  "author": "Corenthin Buffard",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Corenthin-Buffard/AgentDeck.git"
  },
  "scripts": {
    "test": "bun test",
    "build": "bun build src/main.ts --compile --outfile dist/agentdeck",
    "daemon": "bun run src/main.ts",
    "dev": "bun --watch run src/main.ts",
    "hooks": "bun run spike/hook-server.ts",
    "spike": "bun run spike/run.ts",
    "spike:gstack": "bun run spike/run.ts --gstack"
  }
}
