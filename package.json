{
  "name": "agentdeck",
  "version": "0.1.3.8",
  "type": "module",
  "private": true,
  "description": "AgentDeck — self-hosted, gstack-native orchestrator for parallel Claude Code agents. Air-traffic-control board for your VPS.",
  "scripts": {
    "test": "bun test",
    "build": "bun build src/daemon.ts --compile --outfile dist/agentdeck",
    "daemon": "bun run src/daemon.ts",
    "dev": "bun --watch run src/daemon.ts",
    "hooks": "bun run spike/hook-server.ts",
    "spike": "bun run spike/run.ts",
    "spike:gstack": "bun run spike/run.ts --gstack"
  }
}
